# srsUE (5G SA) over ZeroMQ, paired with ~/gnb_zmq.yml. Subscriber {{ open5gs_subscribers[0].imsi }} is in Open5GS.
#
# Run: sudo ip netns add ue1   (once per boot)
#      sudo ~/srsRAN_4G/build/srsue/src/srsue ~/ue_zmq.conf

[rf]
freq_offset = 0
tx_gain = 50
rx_gain = 40
srate = 23.04e6
nof_antennas = 1
device_name = zmq
device_args = tx_port=tcp://127.0.0.1:2001,rx_port=tcp://127.0.0.1:2000,base_srate=23.04e6

[rat.eutra]
dl_earfcn = 2850
nof_carriers = 0

[rat.nr]
bands = 3
nof_carriers = 1
max_nof_prb = 106
nof_prb = 106

[pcap]
enable = none
mac_filename = /tmp/ue_mac.pcap
mac_nr_filename = /tmp/ue_mac_nr.pcap
nas_filename = /tmp/ue_nas.pcap

[log]
all_level = warning
phy_lib_level = none
all_hex_limit = 32
filename = /tmp/ue.log
file_max_size = -1

[usim]
mode = soft
algo = milenage
opc  = {{ open5gs_subscribers[0].opc }}
k    = {{ open5gs_subscribers[0].k }}
imsi = {{ open5gs_subscribers[0].imsi }}
imei = {{ open5gs_subscribers[0].imei | default('353490069873319') }}

[rrc]
release = 15
ue_category = 4

[nas]
apn = internet
apn_protocol = ipv4

[gw]
netns = ue1
ip_devname = tun_srsue
ip_netmask = 255.255.255.0

[gui]
enable = false
