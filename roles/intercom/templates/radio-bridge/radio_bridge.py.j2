"""OpenWebRX+ -> Open Intercom radio bridge.

Listens to OpenWebRX+ like a browser would (websocket on 127.0.0.1:8073), on whatever the receiver is tuned
to: the active SDR profile's frequency and mode. It follows profile changes made by anyone in OpenWebRX.
It publishes that audio over WHIP into every Intercom line named RADIO_LINE (default "Radio"), as its own
participant, e.g. "Radio 446.006 NFM". Crew who want to hear the radio add that line to their panel.

Always on: it reconnects by itself, and follows lines being added and removed (checked every POLL seconds).
Profiles without audio (ADS-B, ISM decoders, ...) give silence and the participant name says "no audio".
On/off: the switch on Homepage (Caddy serves this service at /radio/ behind the login) or `obcell radio on|off`.
Off leaves the lines and disconnects from OpenWebRX (so the receiver can idle); the choice survives restarts.
Status: http://127.0.0.1:9104/status (JSON) and /metrics (Prometheus).
"""
import asyncio
import fractions
import json
import logging
import os
import re
import signal
import time

import aiohttp
import av
import numpy as np
from aiohttp import web
from aiortc import rtp as aiortc_rtp
from aiortc import RTCConfiguration, RTCPeerConnection, RTCSessionDescription, MediaStreamTrack

OWRX_WS = os.environ.get("OWRX_WS", "ws://127.0.0.1:8073/ws/")
MANAGER = os.environ.get("INTERCOM_MANAGER", "http://127.0.0.1:8000").rstrip("/")
WHIP_KEY = os.environ.get("WHIP_AUTH_KEY", "").strip()
RADIO_LINE = os.environ.get("RADIO_LINE", "Radio").strip().lower()
NAME_PREFIX = os.environ.get("RADIO_NAME", "Radio")
GAIN = 10 ** (float(os.environ.get("RADIO_GAIN_DB", "0")) / 20)
POLL = float(os.environ.get("POLL_SECONDS", "10"))
STATUS_PORT = int(os.environ.get("STATUS_PORT", "9104"))
STATE_FILE = os.environ.get("STATE_FILE", "/state/radio.json")
