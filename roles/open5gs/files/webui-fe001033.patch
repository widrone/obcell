From fe001033625a74cd23e8d78d234f8b76c8697c70 Mon Sep 17 00:00:00 2001
From: Soma Aishwarya <soma@digiscrypt.com>
Date: Mon, 16 Nov 2026 11:37:15 +0530
Subject: [PATCH] webui: check account rules against the stored account, not
 the token

The JWT carries the username and roles it was issued with and has no
expiry, and the passport-jwt callback returns it without a lookup. A
token issued before an admin was demoted or an account was deleted kept
its old rights on /api/db/Account, and since self-updates were matched
on the username in the token, an old token could change the password of
a new account that reused the same username.

Look the caller up by the token's _id on every Account request and
apply the role and self-update checks to the stored account. A token
whose account no longer exists gets a 401.
---
 webui/server/routes/db.js | 25 ++++++++++++++++++++++---
 1 file changed, 22 insertions(+), 3 deletions(-)

diff --git a/webui/server/routes/db.js b/webui/server/routes/db.js
index 2d6cf44810..d0893a97ed 100644
--- a/webui/server/routes/db.js
+++ b/webui/server/routes/db.js
@@ -27,17 +27,36 @@ restify.serve(router, Profile, {
  * document back, so a non-admin's other fields (roles, username) are dropped
  * rather than rejected.
  */
+const Account = require('../models/account');
+
+/*
+ * The token keeps the username and roles it was issued with and does not
+ * expire, so look the caller up again by _id and apply the rules to the
+ * stored account. A deleted account, a role change, or a username reused by
+ * a new account then takes effect on the next request.
+ */
+const loadCaller = (req, res, next) => {
+  Account.findById(req.user._id, 'username roles', (err, account) => {
+    if (err)
+      return next(err);
+    if (!account)
+      return res.sendStatus(401);
+    req.caller = account;
+    next();
+  });
+};
+
 const isAdmin = req =>
-  Array.isArray(req.user.roles) && req.user.roles.indexOf('admin') !== -1;
+  Array.isArray(req.caller.roles) && req.caller.roles.indexOf('admin') !== -1;
 
 const requireAdmin = (req, res, next) =>
   isAdmin(req) ? next() : res.sendStatus(403);
 
-const Account = require('../models/account');
 restify.serve(router, Account, {
   prefix: '',
   version: '',
   idProperty: 'username',
+  preMiddleware: loadCaller,
   preRead: (req, res, next) => {
     /*
      * hash and salt are select:false in the schema, but the select,
@@ -52,7 +71,7 @@ restify.serve(router, Account, {
     if (isAdmin(req))
       return next();
 
-    if (req.params.id !== req.user.username)
+    if (req.params.id !== req.caller.username)
       return res.sendStatus(403);
 
     const body = {};
