# Open Live self-hosted stack on {{ obcell_name }} ({{ obcell_lan_ip }}).
#
# Browser entry point: https://{{ obcell_mdns_name }}:7443 (LAN, Caddy internal CA) or https://{{ obcell_tailnet_name }}:7443.
#   /authelia/*                          -> Authelia login page
#   /guest/*, /api/v1/guests/*, /health  -> open-live, no login (invite tokens protect them)
#   /api/*, /ws/*, /documentation*       -> open-live, Authelia session required
#   everything else                      -> open-live-studio, Authelia session required
# Strom runs on the host network so WebRTC/SRT media reaches it without Docker NAT.
#
# Secrets live in ./.env (chmod 600). Start: sudo docker compose up -d --build

name: openlive

services:
  couchdb:
    image: couchdb@sha256:907eab5b7e55ab7cfd241d39b90b2a335ea40bef82acee5a37388c08bf201dda
    restart: unless-stopped
    # Keep off {{ 'cores ' ~ gnb_cpu_range }}, which the gNB needs for real-time processing.
    {{ container_cpuset_line }}
    logging:
      driver: local
      options:
        max-size: 10m
    environment:
      COUCHDB_USER: ${COUCHDB_USER}
      COUCHDB_PASSWORD: ${COUCHDB_PASSWORD}
    ports:
      - "127.0.0.1:5984:5984"
    volumes:
      - couchdb_data:/opt/couchdb/data

  strom:
    image: eyevinntechnology/strom-full@sha256:04f7ec8478c4db0891ac69f5b858030630ee7a8cad552cbbbecd5f8c8fa9f436
    restart: unless-stopped
    network_mode: host
    # Keep media work off {{ 'cores ' ~ gnb_cpu_range }}, which the gNB needs for real-time processing.
    {{ container_cpuset_line }}
    cap_add:
      - SYS_NICE
{% if obcell_gpu_dri %}
    # Intel iGPU for OpenGL compositing. Without it Mesa falls back to llvmpipe (software GL), which saturates the CPU.
    devices:
      - /dev/dri:/dev/dri
    group_add:
{% for g in obcell_gpu_gids %}
      - "{{ g }}"
{% endfor %}
    # The image's entrypoint only recognises NVIDIA GPUs and otherwise forces GStreamer GL onto Xvfb/GLX
    # (software llvmpipe). Re-point GStreamer GL at the Intel GPU via EGL; CEF keeps the entrypoint's software flags.
    command: ["/bin/sh", "-c", "export GST_GL_WINDOW=egl-device GST_GL_PLATFORM=egl; exec /app/strom"]
{% endif %}
    environment:
      TZ: {{ obcell_timezone }}
      STROM_PORT: "8080"
      STROM_ADMIN_USER: admin
      STROM_ADMIN_PASSWORD_HASH: ${STROM_ADMIN_PASSWORD_HASH}
      STROM_API_KEY: ${STROM_API_KEY}
    volumes:
      - ./data/strom:/data
    logging:
      driver: json-file
      options:
        max-size: 50m
        max-file: "5"

  open-live:
    build: ./open-live
    restart: unless-stopped
    # Keep off {{ 'cores ' ~ gnb_cpu_range }}, which the gNB needs for real-time processing.
    {{ container_cpuset_line }}
    logging:
      driver: local
      options:
        max-size: 10m
    depends_on:
      - couchdb
      - strom
    extra_hosts:
      - "host.docker.internal:host-gateway"
    ports:
      - "127.0.0.1:3000:3000"
    environment:
      NODE_ENV: production
      PORT: "3000"
      COUCHDB_URL: http://couchdb:5984
      COUCHDB_USER: ${COUCHDB_USER}
      COUCHDB_PASSWORD: ${COUCHDB_PASSWORD}
      COUCHDB_NAME: open-live
      STROM_URL: http://host.docker.internal:8080
      STROM_AUTH_MODE: direct
      STROM_AUTH_TOKEN: ${STROM_API_KEY}
      SRT_PUBLIC_HOST: {{ obcell_lan_ip }}
      # LAN + tailnet: WHIP callback URLs use the host the production was activated from, limited to
      # these names (needs the local TRUSTED_HOSTS patch in open-live/src/main.ts).
      TRUSTED_HOSTS: {{ obcell_names | join(',') }}
      # Keeps the Strom port-lease owner id it had when PUBLIC_BASE_URL was https://{{ obcell_mdns_name }}.
      STROM_PORT_LEASE_CLIENT_ID: {{ obcell_mdns_name }}
      CORS_ORIGIN: {{ obcell_names | obcell_urls(7443) | join(',') }}
      # Caddy + Authelia enforce the operator login; guest routes use their own invite tokens.
      TRUST_EXTERNAL_AUTH: "true"
      LOG_LEVEL: info

  studio:
    build: ./open-live-studio
    restart: unless-stopped
    # Keep off {{ 'cores ' ~ gnb_cpu_range }}, which the gNB needs for real-time processing.
    {{ container_cpuset_line }}
    logging:
      driver: local
      options:
        max-size: 10m
    depends_on:
      - open-live
    ports:
      - "127.0.0.1:8081:8080"
    environment:
      OPEN_LIVE_URL: https://{{ obcell_mdns_name }}   # baseline only: Caddy serves env-config.js + CSP per host (see Caddyfile)

  # Pulls the RTMPS feeds (rtmps-relay/feeds.conf) and pushes them, remuxed, into Strom's SRT listeners
  # 9001/9002 while the production is active. Open Live/Strom have no RTMP input.
  rtmps-relay:
    build: ./rtmps-relay
    restart: unless-stopped
    logging:
      driver: local
      options:
        max-size: 10m
    network_mode: host
    {{ container_cpuset_line }}
    volumes:
      - ./rtmps-relay/feeds.conf:/config/feeds.conf:ro

  authelia:
    image: authelia/authelia@sha256:bd97cff4fcbf715b5ff1f9ae286afbe6033afce385302520b0368122d43a6f54
    restart: unless-stopped
    # Keep off {{ 'cores ' ~ gnb_cpu_range }}, which the gNB needs for real-time processing.
    {{ container_cpuset_line }}
    logging:
      driver: local
      options:
        max-size: 10m
    network_mode: host
    environment:
      TZ: {{ obcell_timezone }}
      AUTHELIA_SESSION_SECRET: ${AUTHELIA_SESSION_SECRET}
      AUTHELIA_STORAGE_ENCRYPTION_KEY: ${AUTHELIA_STORAGE_ENCRYPTION_KEY}
      AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET: ${AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET}
    volumes:
      - ./authelia:/config
      - authelia_data:/data

  caddy:
    image: caddy@sha256:4851e54a46b206517c574821bb5cc67f170d2156041e9fbc4c9193b45e84a75b
    restart: unless-stopped
    # Keep off {{ 'cores ' ~ gnb_cpu_range }}, which the gNB needs for real-time processing.
    {{ container_cpuset_line }}
    logging:
      driver: local
      options:
        max-size: 10m
    network_mode: host
    # Front door for every web UI: depends only on the login, not on the production stack.
    depends_on:
      - authelia
    volumes:
      # Directory mount (not the single file) so editors/sed -i that replace the file are picked up.
      - ./caddy:/etc/caddy:ro
{% if tailscale_enabled %}
      # Tailscale LocalAPI: Caddy fetches the *.ts.net certificates from tailscaled.
      - /var/run/tailscale:/var/run/tailscale
{% endif %}
      - caddy_data:/data
      - caddy_config:/config

volumes:
  couchdb_data:
  authelia_data:
  caddy_data:
  caddy_config:
