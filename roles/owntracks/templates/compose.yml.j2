# OwnTracks Recorder on {{ obcell_name }}: where the crew's phones are (OwnTracks app, HTTP mode).
#
# Browser + app entry point: https://{{ obcell_mdns_name }}:{{ owntracks_https_port }} (Caddy, see ~/openlive/caddy/Caddyfile)
#   /pub            -> the Recorder, app login (Caddy basic auth; the username becomes the OwnTracks user)
#   everything else -> the Recorder's map, table and API, operator login (Authelia)
{% if owntracks_funnel %}
# Public: https://{{ obcell_tailnet_name }}:{{ owntracks_funnel_port }}/pub via Tailscale Funnel -> Caddy 127.0.0.1:{{ owntracks_funnel_local_port }} (/pub only).
{% endif %}
# The Recorder has no login of its own, so it only listens on 127.0.0.1. No MQTT broker.
#
# Location history: ./store (root-owned). Start: sudo docker compose up -d

name: owntracks

services:
  recorder:
    image: owntracks/recorder@sha256:8d48df647eb280bb94668658b7fc7ad3b47b9a7307e252aaf63d4c3681c6deaf   # 1.0.7
    restart: unless-stopped
    # Keep off {{ 'cores ' ~ gnb_cpu_range }}, which the gNB needs for real-time processing.
    {{ container_cpuset_line }}
    logging:
      driver: local
      options:
        max-size: 10m
    environment:
      TZ: {{ obcell_timezone }}
      OTR_PORT: "0"                 # MQTT off: the apps POST to /pub instead
      OTR_HTTPHOST: 0.0.0.0
      OTR_HTTPPORT: "8083"
      OTR_SERVERLABEL: {{ obcell_name }}
    ports:
      - "127.0.0.1:{{ owntracks_recorder_port }}:8083"
    volumes:
      - ./store:/store
